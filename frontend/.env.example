# Copy to frontend/.env.local. Not needed in demo mode.

# Spotify app Client ID (public: the app uses PKCE, so there is no client secret).
# Create an app at https://developer.spotify.com/dashboard and add these redirect URIs:
#   http://127.0.0.1:5175/callback   (npm run dev)
#   http://127.0.0.1:8080/callback   (Docker)
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
